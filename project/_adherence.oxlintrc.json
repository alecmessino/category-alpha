{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/data/**",
              "components/primitives/**",
              "components/surfaces/**",
              "components/telemetry/**",
              "prototypes/millibar-terminal/**",
              "ui_kits/millibar-terminal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Erode|Satoshi|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Erode, Satoshi, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|mono|dot|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, mono, dot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|pos|warn|neg|special|live|seeded)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'pos' | 'warn' | 'neg' | 'special' | 'live' | 'seeded'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|active|mono|disabled|onClick|title|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, active, mono, disabled, onClick, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|accent|segment|preset)$/]",
        "message": "<Button> variant must be one of 'solid' | 'accent' | 'segment' | 'preset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EdgeCell'] > JSXAttribute > JSXIdentifier[name!=/^(?:contract|edge|marketPct|liquidity|theoretical|capped|allocation|stakePct|rawPct|style|key|ref|className|style|children)$/]",
        "message": "<EdgeCell> doesn't accept that prop. Declared props: contract, edge, marketPct, liquidity, theoretical, capped, allocation, stakePct, rawPct, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|message|awaiting|status|statusTone|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, message, awaiting, status, statusTone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute[name.name='statusTone'] > Literal[value!=/^(?:pos|warn|neg|special|neutral)$/]",
        "message": "<EmptyState> statusTone must be one of 'pos' | 'warn' | 'neg' | 'special' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Gauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|color|gradient|height|style|key|ref|className|style|children)$/]",
        "message": "<Gauge> doesn't accept that prop. Declared props: value, color, gradient, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|detail|status|style|key|ref|className|style|children)$/]",
        "message": "<HealthRow> doesn't accept that prop. Declared props: name, detail, status, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthRow'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:PASS|EMPTY|BLOCKED|FAIL)$/]",
        "message": "<HealthRow> status must be one of 'PASS' | 'EMPTY' | 'BLOCKED' | 'FAIL'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedStream'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|status|age|penalty|key|ref|className|style|children)$/]",
        "message": "<FeedStream> doesn't accept that prop. Declared props: name, status, age, penalty."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeedStream'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|stale|missing)$/]",
        "message": "<FeedStream> status must be one of 'ok' | 'stale' | 'missing'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KellyBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:theoretical|capped|allocation|rawPct|stakePct|scale|showCaption|style|key|ref|className|style|children)$/]",
        "message": "<KellyBar> doesn't accept that prop. Declared props: theoretical, capped, allocation, rawPct, stakePct, scale, showCaption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|right|accent|footer|pad|style|bodyStyle|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, title, right, accent, footer, pad, style, bodyStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|dotColor|mono|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: children, active, dotColor, mono, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Pill> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceFooter'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|latency|version|tier|items|style|key|ref|className|style|children)$/]",
        "message": "<ProvenanceFooter> doesn't accept that prop. Declared props: source, latency, version, tier, items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProvenanceFooter'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:A|B|C)$/]",
        "message": "<ProvenanceFooter> tier must be one of 'A' | 'B' | 'C'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReplayBookmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:i|label|color|key|ref|className|style|children)$/]",
        "message": "<ReplayBookmark> doesn't accept that prop. Declared props: i, label, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|signal|edge|modelProb|marketProb|conf|confReason|unmapped|Badge|style|key|ref|className|style|children)$/]",
        "message": "<SignalCard> doesn't accept that prop. Declared props: label, signal, edge, modelProb, marketProb, conf, confReason, unmapped, Badge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalCard'] > JSXAttribute[name.name='signal'] > Literal[value!=/^(?:BUY|SELL|HOLD)$/]",
        "message": "<SignalCard> signal must be one of 'BUY' | 'SELL' | 'HOLD'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalCard'] > JSXAttribute[name.name='conf'] > Literal[value!=/^(?:HIGH|MED|MEDIUM|LOW)$/]",
        "message": "<SignalCard> conf must be one of 'HIGH' | 'MED' | 'MEDIUM' | 'LOW'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|unit|sub|color|variant|style|key|ref|className|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: label, value, unit, sub, color, variant, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:tile|metric)$/]",
        "message": "<StatTile> variant must be one of 'tile' | 'metric'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|color|size|pulse|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, color, size, pulse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|live|stale|missing|neutral)$/]",
        "message": "<StatusDot> status must be one of 'ok' | 'live' | 'stale' | 'missing' | 'neutral'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
